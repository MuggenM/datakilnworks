# Port 8888 is already bound by jupyter_sqlframe on the host, defaulting to 8890
HOST_PORT=8890
STUDIO_PORT=8891
JUPYTER_TOKEN=databricks

# Bootstrap admin account -- consulted ONLY the first time the studio starts against a brand-new,
# empty warehouse volume (an already-seeded warehouse, including any existing deployment, is never
# touched). Required at that point or the studio refuses to start, since there would be no way to log in.
#
# 1. Generate a hash (never put a plaintext password here):
#      docker compose exec datakilnworks-studio python -m web.auth hash-password
# 2. Paste the result below and uncomment these lines:
# INIT_ADMIN_USERNAME=admin
# INIT_ADMIN_PASSWORD_HASH=pbkdf2_sha256$100000$...
# INIT_ADMIN_DISPLAY_NAME=System Administrator
#
# The bootstrap admin must change this password on first login (enforced server-side, not just in the UI).
