# Local settings for docker compose (gitignored). See .env.example for everything that can be set here.

# --- Docker socket for the container-controller (container auto-suspend of the compute nodes) ---------------------------
# The controller needs the socket of the Docker daemon that runs THIS stack. Which path is right depends on how Docker
# is installed. Only ONE of the two lines below may be active.
#
#   /run/user/1000/docker.sock   ROOTLESS Docker: the daemon runs as your own user (this machine: `docker info` lists
#                                "rootless" under Security Options, and `docker context ls` marks the "rootless" context).
#                                The socket lives under $XDG_RUNTIME_DIR; 1000 is your user id (`id -u`).
#                                Using /var/run/docker.sock here fails with "permission denied", because that path
#                                belongs to a different (rootful) daemon, if one exists at all.
#
#   /var/run/docker.sock         ROOTFUL Docker (the standard install: the daemon runs as root, `docker info` shows no
#                                "rootless"). This is also compose's default when the variable is unset. Use it on servers
#                                and on most Linux desktops that installed docker-ce / docker.io normally.
#
# Not sure? Run:  docker context inspect --format '{{.Endpoints.docker.Host}}'   and use the path after "unix://".
DOCKER_SOCKET_PATH=/run/user/1000/docker.sock
# DOCKER_SOCKET_PATH=/var/run/docker.sock
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD_HASH='<hashed_password>'
INIT_ADMIN_DISPLAY_NAME=System Administrator

# Git sync of the SHARED notebooks (Workspace > Git). Only notebooks/Shared is synchronised, never the private Users/ folders, and
# outputs are stripped from committed notebooks. Same rules as above: http(s) URL without credentials, token in its own variable
# (falls back to GIT_TOKEN, so one token works when both live in the same Gitea). Use a repository of its own.
# NOTEBOOKS_GIT_REMOTE_URL=http://gitea:3000/dkw/notebooks.git
# NOTEBOOKS_GIT_BRANCH=main
# NOTEBOOKS_GIT_TOKEN=
