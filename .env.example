# Port 8888 is already bound by jupyter_sqlframe on the host, defaulting to 8890
HOST_PORT=8890
STUDIO_PORT=8891
JUPYTER_TOKEN=databricks

# Bootstrap admin account -- consulted ONLY the first time the studio starts against a brand-new,
# empty warehouse volume (an already-seeded warehouse, including any existing deployment, is never
# touched). Required at that point or the studio refuses to start, since there would be no way to log in.
#
# 1. Generate a hash (never put a plaintext password here):
#      docker compose exec datakilnworks-studio python -m web.auth hash-password
# 2. Paste the result below and uncomment these lines:
# INIT_ADMIN_USERNAME=admin
# INIT_ADMIN_PASSWORD_HASH='pbkdf2_sha256$100000$...'   # keep the single quotes: unquoted, Compose expands each $... as a variable and breaks the hash
# INIT_ADMIN_DISPLAY_NAME=System Administrator
#
# The bootstrap admin must change this password on first login (enforced server-side, not just in the UI).

# Container auto-suspend: idle SQL warehouses really stop their compute-node container and resume on the next query.
# The container-controller service needs the Docker socket. Rootful Docker: the default (/var/run/docker.sock).
# Rootless Docker keeps it elsewhere:  DOCKER_SOCKET_PATH=/run/user/1000/docker.sock   (i.e. $XDG_RUNTIME_DIR/docker.sock)
# DOCKER_SOCKET_PATH=/var/run/docker.sock
# WAREHOUSE_SUSPEND_MODE=stop        # stop (frees memory, resume takes seconds) | pause (freeze; instant resume, memory stays)

# dbt project location. Default: ./dbt_project inside this repository (fine for development). In production keep the dbt project
# (models, profiles.yml, dbt_project.yml) in its OWN git repository and mount a checkout of it here; an empty directory is seeded
# from web/dbt_template on first start. The studio never commits: edits made under Transformations > Project files change the
# working tree, so commit them from your own workflow. Config history and the audit trail live in the warehouse metadata.
# DBT_PROJECT_HOST_DIR=/srv/analytics/dbt_project

